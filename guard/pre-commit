#!/usr/bin/env bash
# KAVANA Agent Lite: puerta de pre-commit. Corta el commit si el escáner
# encuentra contaminación. Esta es la copia del repositorio; para encenderla en
# cualquier repositorio, ejecuta ./install.sh --gancho.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PYTHON="${PYTHON:-python3}"

if ! "$PYTHON" "$REPO_ROOT/guard/scan.py" --staged; then
  echo ""
  echo "Commit cortado por la puerta."
  echo "Si un hallazgo es un falso positivo, decláralo en guard/allow.local.txt (no se publica)."
  exit 1
fi
